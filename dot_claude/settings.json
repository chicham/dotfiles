{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opusplan",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | { read file_path; case \"$file_path\" in *.py) uv run ruff check --fix --ignore RUF100 -q \"$file_path\" >&2; uv run ruff format -q \"$file_path\" >&2; uv run ruff check --ignore RUF100 \"$file_path\" >&2 || exit 2 ;; esac; }"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hicham.randrianarivo/.local/bin/zjherd-report claude PostToolUse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hicham.randrianarivo/.local/bin/zjherd-report claude SessionStart"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hicham.randrianarivo/.local/bin/zjherd-report claude UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hicham.randrianarivo/.local/bin/zjherd-report claude PreToolUse"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hicham.randrianarivo/.local/bin/zjherd-report claude Notification"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hicham.randrianarivo/.local/bin/zjherd-report claude Stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/hicham.randrianarivo/.local/bin/zjherd-report claude SessionEnd"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cship"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {},
  "outputStyle": "Terse",
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "autoCompactWindow": 500000,
  "advisorModel": "fable",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {}
}
