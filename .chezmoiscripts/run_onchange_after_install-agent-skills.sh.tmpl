#!/bin/sh
# Install agent skills with `gh skill`, driven by .chezmoidata/skills.yaml.
# Re-runs whenever that manifest changes:
# skills.yaml hash: {{ include ".chezmoidata/skills.yaml" | sha256sum }}

set -eu

if ! command -v gh > /dev/null 2>&1; then
  echo "Warning: gh not found, skipping skill installation." >&2
  exit 0
fi

# `gh skill` landed in GitHub CLI 2.93.
if ! gh skill --help > /dev/null 2>&1; then
  echo "Warning: this gh has no 'skill' command (needs 2.93+), skipping." >&2
  exit 0
fi

if ! gh auth status > /dev/null 2>&1; then
  echo "Warning: gh is not authenticated, skipping skill installation." >&2
  echo "  Run 'gh auth login', then 'chezmoi apply' again." >&2
  exit 0
fi

install_skill() {
  repo="$1"
  path="$2"
  extra="$3"
  # shellcheck disable=SC2086 # extra is an intentional flag list
  gh skill install "${repo}" "${path}" \
    --agent claude-code --scope user --force ${extra} > /dev/null 2>&1 ||
    echo "Warning: failed to install ${path} from ${repo}" >&2
}

# Install every skill a repository publishes, discovering the list from the
# repository itself rather than from a hand-maintained list.
install_repo() {
  repo="$1"
  paths=$(gh api "repos/${repo}/git/trees/HEAD?recursive=1" \
    --jq '.tree[] | select(.path | endswith("/SKILL.md")) | .path | sub("/SKILL.md$";"")' 2> /dev/null) || {
    echo "Warning: could not list skills in ${repo}" >&2
    return 0
  }
  if [ -z "${paths}" ]; then
    echo "Warning: no skills found in ${repo}" >&2
    return 0
  fi
  for path in ${paths}; do
    install_skill "${repo}" "${path}" ""
  done
}

echo "Installing/updating agent skills via gh skill..."
{{ range .skills }}
{{- $repo := .repo }}
{{- if hasKey . "all" }}
install_repo {{ $repo | quote }}
{{- else }}
{{- $extra := "" }}
{{- if hasKey . "allow_hidden_dirs" }}{{ $extra = "--allow-hidden-dirs" }}{{ end }}
{{- range .paths }}
install_skill {{ $repo | quote }} {{ . | quote }} {{ $extra | quote }}
{{- end }}
{{- end }}
{{ end }}
echo "Agent skills up to date. Refresh later with: gh skill update --all"
