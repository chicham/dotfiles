#!/bin/bash
# Re-run whenever any local skill's SKILL.md changes:
{{ range .skills.local -}}
# custom-skills/{{ . }}/SKILL.md hash: {{ include (printf "custom-skills/%s/SKILL.md" .) | sha256sum }}
{{ end -}}

set -eu

if ! command -v bunx >/dev/null 2>&1; then
    echo "Warning: bunx not found, skipping skill installation." >&2
    exit 0
fi

echo "Installing/updating local agent skills..."
{{ range .skills.local -}}
bunx skills add "$HOME/.local/share/chezmoi/custom-skills/{{ . }}" -g --all
{{ end -}}
