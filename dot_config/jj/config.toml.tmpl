# chezmoi:template:left-delimiter="# [[" right-delimiter="]] #"
"$schema" = "https://jj-vcs.github.io/jj/latest/config-schema.json"

[user]
# [[ if hasKey . "name" -]] #
# [[ if ne .name "" -]] #
name = # [[ .name | quote ]] #
# [[- end ]] #
# [[- end ]] #
# [[ if hasKey . "email" -]] #
# [[ if ne .email "" -]] #
email = # [[ .email | quote ]] #
# [[- end ]] #
# [[- end ]] #

# [[ if and (hasKey . "signingKey") (ne .signingKey "") -]] #
[signing]
behavior = "own"
backend = "ssh"
key = # [[ .signingKey | quote ]] #
sign-all = true

[signing.backends.ssh]
# [[ if eq .chezmoi.os "darwin" -]] #
program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
# [[ else -]] #
program = "/usr/local/bin/op-ssh-sign"
# [[ end -]] #
# [[ end -]] #
[git]
private-commits = '''description(glob:'private:*') | description(glob:'wip*')'''

[ui]
editor = "nvim"
diff-editor = "oyui"
diff-formatter = ["difft", "--color=always", "--display=inline", "$left", "$right"]
diff-instructions = false
merge-editor = "diffconflicts"
default-command = ["log", "--no-pager", "--reversed"]
pager = "bat --style=plain"
conflict-marker-style = "diff"
log-word-wrap = true

[merge-tools.oyui]
program = "oyui"
edit-args = ["diff", "$left", "$right"]

[aliases]

# Command aliases are kept to what a revset alias cannot do; everything else is a
# built-in command over a revset alias (see [revset-aliases]):
#   jj log                               main, every arm, and @ (revsets.log = megamerge())
#   jj log -r 'arm_tips()'               one tip per arm in flight
#   jj diff -r 'chain(@)'                what my arm changes
#   jj log -r 'mm_arm_violations(@)'     my arm against the megamerge rules: must be empty
#   jj log -r 'no_issue()'               arm commits still needing `jj issue-new`
#   jj abandon -r 'leftovers()'          drop empty undescribed leftovers (preview with jj log)
#
# Every fish-backed alias ends with "--" so a leading flag (`jj pull --all-remotes`)
# reaches the function instead of fish itself.

# Run every prek hook on the content of each commit of a revset (default @), each in its own
# `jj run` checkout with a throwaway git index: from a workspace, a plain `prek run` checks
# the root checkout's files instead. prek is the version the project pins, else the latest.
# Usage: `jj prek [<revset>]`. Logic: jj-prek.fish.
prek = ["util", "exec", "--", "fish", "-c", "jj-prek $argv", "--"]

# Push named bookmarks once `jj prek` passes on their tips (what the remote ends up with); carries the
# guard's push rules (named only, no wip, no main while mm_unpushed_forks()).
# Usage: `jj push -b NAME [--remote NAME]`. Logic: jj-push.fish.
push = ["util", "exec", "--", "fish", "-c", "jj-push $argv", "--"]

# Deploy every arm: gate each arm, rebase `wip` onto `arm_tips()`, gate `wip` (no
# conflict, exactly the arm tips as parents, no other merge), push it to the deploy remote.
# The only command that rewires wip. `jj deploy --no-push` rebuilds and gates only;
# `--remote NAME` overrides the deploy remote. Logic: ~/.config/fish/functions/deploy.fish.
deploy = ["util", "exec", "--", "fish", "-c", "deploy $argv", "--"]

# Land my arm locally: rebase it onto main when stale, refuse on a peer sitting on it or
# on a conflict (after `jj automerge`; a clean automerge also stops, for review: rerun),
# advance main to its tip (forward-only). Never touches another arm or
# wip; the next `jj deploy` drops the landed arm from wip.
# Usage: `jj land [-b <bookmark>] [<rev>]` (default @: lands `tip(@)`; default bookmark main).
# Only a land on main closes the `Closes: org:<UUID>` tasks and moves the orphan arms. Logic: land.fish.
land = ["util", "exec", "--", "fish", "-c", "land $argv", "--"]

# Local only, no fetch: rebase my arm onto main, then every arm no workspace sits on
# (one rebase per arm, reverted if `jj automerge` cannot clear its conflicts), after
# `jj automerge` on my own arm; name the owned arms still behind.
# Never touches an owned arm or wip. Logic: ~/.config/fish/functions/jj-sync.fish.
sync = ["util", "exec", "--", "fish", "-c", "jj-sync $argv", "--"]

# Resolve the 2-sided conflicts of my arm with mergiraf (jj's built-in tool entry): one
# operation per conflicted commit, oldest first; prints the files merged and left, and the
# `jj op revert` that undoes it. `jj land`, `jj sync` and `jj pull` run it themselves.
# Usage: `jj automerge [<revset>]` (default chain(@)). Logic: automerge.fish.
automerge = ["util", "exec", "--", "fish", "-c", "automerge $argv", "--"]

# `jj git fetch`, then resolve a conflicted main to main@origin (refused if that drops
# unpushed work), then `jj sync`, which also drops the copies the forge already merged.
# Arguments go to the fetch. Logic: pull.fish.
pull = ["util", "exec", "--", "fish", "-c", "pull $argv", "--"]

# Open or refresh the PRs of a stack. One PR is one commit, and a PR is a feature group.
# Usage: `jj pr <arm-tip>` (gates + dry-run), `jj pr <arm-tip> --push` (submit, new PRs as
# drafts), `jj pr <arm-tip> --push --open` (mark ready). Logic: ~/.config/fish/functions/pr.fish.
pr = ["util", "exec", "--", "fish", "-c", "pr $argv", "--"]

# One line per arm commit with its trailer lines (see `no_issue()` for what counts), or `-`
# when it has none.
# Org task titles: `orgtool find --id <uuid>`.
# Extra `-r <revset>` args are unioned, e.g. `jj issues -r 'unpushed()'` = what the
# next push closes.
issues-raw = ["log", "--no-graph", "-r", "arms()", "-T", 'change_id.short() ++ " " ++ description.first_line() ++ "  " ++ coalesce(description.lines().filter(|l| l.match(regex:"^[[:blank:]]*(?:(?i:closes|fixes|resolves)(?::[[:blank:]]*| )#[0-9]+|(?i:issue):[[:blank:]]*#[0-9]+|(?i:closes|fixes|resolves|issue):[[:blank:]]*org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})[[:blank:]]*$") != "").join(", "), "-") ++ "\n"']
issues = ["util", "exec", "--", "bash", "# [[ .chezmoi.homeDir ]] #/.config/jj/jj-issues"]

# Open a GitHub issue from a commit that has none, and add `Closes #N` to it:
# `jj issue-new <rev> [--parent <N>]` (--parent files it as a sub-issue of N).
# Logic: ~/.config/fish/functions/issue-new.fish.
issue-new = ["util", "exec", "--", "fish", "-c", "issue-new $argv", "--"]

[revsets]
# Plain `jj log` shows the megamerge: main, every in-flight chain, and `@`.
log = "megamerge()"
# Bare `jj fix` rewrites my arm only (jj also refits its descendants, i.e. wip). jj's default,
# reachable(@, mutable()), walks through wip into every peer's arm; same scope as automerge.
fix = "(chain(@) & mutable()) ~ present(wip):: ~ ::(working_copies() ~ @ ~ present(wip)::)"

[templates]
log = '''

label(if(current_working_copy, "working_copy"),
  concat(
    separate(" ",
      coalesce(
        if(hidden, label("hidden",
          change_id.shortest(4) ++ label("change_offset", "/") ++ change_offset)),
        if(divergent, label("divergent",
          change_id.shortest(4) ++ label("change_offset", "/") ++ change_offset)),
        change_id.shortest(4),
      ),
      bookmarks,
      tags,
      working_copies,
      commit_id.shortest(4),
      label("author", author.name()),
      if(conflict, label("conflict", "conflict")),
      if(divergent, label("divergent", "divergent")),
      if(hidden, label("hidden", "hidden")),
    ) ++ "\n",
    separate(" ",
      if(empty, label("empty", "(empty)")),
      if(description, description.first_line(), label("empty description placeholder", "(no description set)")),
    ) ++ "\n",
  )
)
'''

["revset-aliases"]
# main and its history are immutable, so jj itself refuses every rewrite of them
# (squash, rebase, describe, abandon, edit, restore), for agents and humans alike;
# `--ignore-immutable` is the deliberate escape hatch. Moving the bookmark (`jj land`)
# is not a rewrite. wip cannot be immutable: every arm sits below it.
"immutable_heads()" = 'builtin_immutable_heads() | present(bookmarks(exact:"main")) | landing()'
# The one bookmark besides main that `jj land -b` may advance: a holding place for work
# that is reviewed and tested but not meant for main yet. It is no arm: sync, pull and land
# never rebase it, and it is immutable like main. Empty until the bookmark `landing` exists.
"landing()" = 'present(bookmarks(exact:"landing"))'
# NOTE: revset function names cannot contain hyphens (jj parses `-` as minus).

# --- Arms -------------------------------------------------------------------------
# An arm is a linear chain off main, built in one workspace. Its commits up to x
# (a deliberate stack also includes the arm it sits on).
"chain(x)" = "main..x"
# The last described commit of x's arm: what lands, gets a PR, or is deployed.
"tip(x)" = 'heads(chain(x) ~ description(exact:""))'
# One tip per arm in flight, read from the graph (never from wip's parents): heads of
# the described mutable commits off main. `heads()` runs after the exclusions, so a
# workspace's undescribed `@` promotes its parent to the tip. Scratch (`wip*`,
# `scratch*`), `private:*` commits and the frozen history pinned by
# provenance/preserve/restore/* bookmarks are never arms.
"arm_tips()" = '''heads(mutable() ~ ::main ~ ::landing() ~ present(wip):: ~ description(exact:"") ~ description(glob:"wip*") ~ description(glob:"scratch*") ~ description(glob:"private:*") ~ ::bookmarks(glob:"provenance/*") ~ ::bookmarks(glob:"preserve/*") ~ ::bookmarks(glob:"restore/*"))'''
# Every commit on every arm.
"arms()" = "(main..arm_tips()) ~ ::landing()"
# Work `jj deploy` leaves out: content in undescribed commits (an agent mid-edit in
# its `@`) that no arm tip contains. jj refuses to push undescribed commits, so they
# cannot be deployed until described.
"left_out()" = '(mutable() ~ ::main ~ present(wip):: ~ ::arm_tips()) & description(exact:"") ~ empty()'
# Arms no workspace sits on: nobody's working copy goes stale when they move, so any
# session may rebase them. Working copies on or above wip (the legacy root) see every
# arm and are ignored. A divergent commit is never an orphan: it is a leftover copy of a
# change whose other copy may be live, and moving it would put both copies on main.
"orphan_arms()" = "arms() ~ ::(working_copies() ~ present(wip)::) ~ divergent()"
# The first commit of each orphan arm that sits on an older main commit: what `jj pull`
# and `jj land` rebase onto main. A root sitting on another arm (a stack) is not stale.
"stale_orphans()" = "roots(orphan_arms()) & (::main ~ main)+"

# --- Megamerge gates: each returns the offending commits; empty = rule holds -------
# `x` is the arm tip being extended (`@` for `jj commit`, the parent for `jj new`).
# Checked before every `jj commit`/`jj new` by the Claude Code hook
# ~/.config/fish/functions/jj-megamerge-guard.fish, and per arm by `jj deploy`.
"mm_merges(x)" = "chain(x) & merges()"
# The arm's first commit does not sit on the current main: stale base, or the arm
# sits on unlanded commits that are not another arm's tip. Work stacked on what landed
# on `landing` is not stale: that bookmark is held back from main on purpose.
"mm_stale(x)" = "roots(chain(x))- ~ main ~ ::landing()"
"mm_conflicts(x)" = "chain(x) & conflicts()"
# Arm tips built on top of x: extending x would fork them (x is mid-arm, or another
# arm deliberately stacked on it). `x ~ ::main` keeps `jj new main` from matching
# every arm.
"mm_stacked_on(x)" = "(arm_tips() & descendants(x ~ ::main)) ~ x"
# Commits x's arm shares with another arm that is neither under x (a deliberate stack
# x sits on) nor above x: a cross-arm dependency.
"mm_forked(x)" = "chain(x) & ::(arm_tips() ~ ::x ~ descendants(x))"
"mm_arm_violations(x)" = "mm_merges(x) | mm_stale(x) | mm_conflicts(x) | mm_stacked_on(x) | mm_forked(x)"
# Extra rules on the parents given to `jj new`: one parent (`latest(x)` is a single
# commit, so anything left over means a merge), not on or above wip, not an old main.
"mm_multi(x)" = "x ~ latest(x)"
"mm_on_wip(x)" = "x & present(wip)::"
"mm_old_main(x)" = "x & ::main ~ main"
# `jj describe -r x` rewrites a message: only commits of my own arm (or @).
"mm_not_mine(x)" = "x ~ chain(@) ~ @"
# Deploy gate on the rewired wip: exactly the arm tips as parents (main alone when
# there is no arm), no other merge, no conflict.
"mm_wip_violations()" = "(wip- ~ (arm_tips() | (main ~ ::arm_tips()))) | (arm_tips() ~ wip-) | ((main..wip & merges()) ~ wip) | (wip & conflicts())"
# Local main commits other than main itself with a child off main's line: an arm forked
# from a commit that is not pushed yet. Rewriting or pushing local main would leave that
# arm on an old copy, so only `main` may have extra children between it and main@origin.
# The guard blocks `jj git push` of main while this is non-empty.
"mm_unpushed_forks()" = "(unpushed() ~ main) & parents(mutable() ~ ::main)"
# Pushed commits other than main that a local arm commit has as parent: an arm forking off
# old pushed history, so main@origin would have a second descendant chain. Remote-tracked
# branches (dependabot/*, other people's PR branches) root in pushed history by design and
# are left out. `parents()` on purpose: `children()` over `::main@origin` returned
# inconsistent results in jj 0.45.1.
"mm_origin_forks()" = "(::main@origin ~ main) & parents(arms() ~ ::remote_bookmarks())"

# --- Views ---------------------------------------------------------------------------
# Default log view: main, every arm, wip and `@`. Spelled with `bookmarks(exact:"main")`
# rather than `main`, because jj also uses this revset to shorten ids: a bare `main`
# errors while the bookmark is conflicted (between a fetch and `jj pull`), and every
# command would then print warnings.
"megamerge()" = 'bookmarks(exact:"main") | remote_bookmarks(exact:"main", exact:"origin") | (mutable() ~ ::bookmarks(exact:"main")) | @'
# Local main commits not on the forge yet: what the next push carries and closes.
"unpushed()" = "::main ~ ::present(main@origin)"
# Arm commits with no trailer line: one that closes or links an issue or an org task. The
# vocabulary is orgtool's (`Closes|Fixes|Resolves[:] #N`, `Issue: #N`, `<keyword>: org:<UUID>`),
# spelled once more in `issues` above and in functions/__trailer_re.fish; tests/jj-megamerge/trailers.bats
# holds the three to one table.
"no_issue()" = 'arms() ~ description(regex:"(?m)^[[:blank:]]*(?:(?i:closes|fixes|resolves)(?::[[:blank:]]*| )#[0-9]+|(?i:issue):[[:blank:]]*#[0-9]+|(?i:closes|fixes|resolves|issue):[[:blank:]]*org:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})[[:blank:]]*$")'
# Local copies of changes whose other copy is immutable (e.g. on main@origin after a
# rebase-merge): what the rebase in `jj pull` drops.
"superseded()" = "divergent() & mutable()"
# Empty undescribed commits nothing needs: never bookmarked (spares `wip`, empty by
# design), never a workspace's @. `jj abandon -r 'leftovers()'`.
"leftovers()" = 'mutable() & empty() & description(exact:"") & ~bookmarks() & ~working_copies()'

[merge-tools.diffconflicts]
program = "nvim"
merge-args = [
    "-c", "let g:jj_diffconflicts_marker_length=$marker_length",
    "-c", "JJDiffConflicts!", "$output", "$base", "$left", "$right",
]
merge-tool-edits-conflict-markers = true

[merge-tools.nbdiff]
program = "nbdiff"
diff-args = ["--color-words", "$left", "$right"]
diff-invocation-mode = "file-by-file"
diff-expected-exit-codes = [0, 1]   # nbdiff exits 1 when it finds differences

# `jj fix`: each changed file goes through a tool on stdin, its stdout replaces the file.
# Tools run from the workspace root, so `uv run --with ruff` takes the venv's pinned ruff,
# else the latest release. --no-sync: jj fix calls the tool once per file, in parallel, and a
# syncing uv would install dependencies (and race on creating .venv) on every call.
# --exit-zero: a lint ruff cannot fix must not discard the fixes it made (jj keeps a file
# only on exit 0); ruff still prints the file unchanged on a syntax error.
[fix.tools.ruff-check]
command = ["uv", "run", "--no-sync", "--with", "ruff", "ruff", "check", "--fix", "--exit-zero", "--stdin-filename=$path", "-"]
patterns = ["glob:'**/*.py'", "glob:'**/*.pyi'"]

[fix.tools.ruff-format]
command = ["uv", "run", "--no-sync", "--with", "ruff", "ruff", "format", "--stdin-filename=$path", "-"]
patterns = ["glob:'**/*.py'", "glob:'**/*.pyi'"]
